# Required - obtain from Anthropic
ANTHROPIC_API_KEY=your-key-here

# Model versions - update when Anthropic releases new versions
HAIKU_MODEL=claude-haiku-4-5-20251001
SONNET_MODEL=claude-sonnet-4-6

# LLM token limits and budgets
HAIKU_MAX_TOKENS=512
SONNET_MAX_TOKENS=2048
SONNET_DAILY_TOKEN_BUDGET=200000
LLM_DAILY_BUDGET_USD=5.0

# Embedding configuration
EMBEDDING_MODEL_NAME=all-mpnet-base-v2
EMBEDDING_MODE=dense

# Clustering and assignment thresholds
CENTROID_ALPHA=0.15
NOISE_BUFFER_THRESHOLD=300
ASSIGNMENT_SIMILARITY_FLOOR=0.55
CONFIDENCE_ESCALATION_THRESHOLD=0.50
# Narratives with NS score >= this value are escalated to Sonnet for mutation analysis
HDBSCAN_MIN_CLUSTER_SIZE=8
HDBSCAN_MIN_SAMPLES=5

# LSH deduplication settings
LSH_THRESHOLD=0.85
LSH_NUM_PERM=128

# Signal computation parameters
VELOCITY_WINDOW_DAYS=7
ENTROPY_VOCAB_WINDOW=10
ENTROPY_MIN_VOCAB_SIZE=3
ASSET_MAPPING_MIN_SIMILARITY=0.60
COHESION_EMA_ALPHA=0.3

# Pipeline frequency and burst velocity
PIPELINE_FREQUENCY_HOURS=4
BURST_VELOCITY_ALERT_RATIO=3.0
SIGNAL_EXTRACTION_STALENESS_HOURS=24
CONVERGENCE_INDEPENDENCE_THRESHOLD=0.30

# File paths
ASSET_LIBRARY_PATH=./data/asset_library.pkl
DB_PATH=./data/narrative_engine.db
LSH_INDEX_PATH=./data/lsh_index.pkl
FAISS_INDEX_PATH=./data/faiss_index.pkl

# Ingestion settings
SCRAPE_MAX_THREADS=3
SYNC_BURST_WINDOW_SECONDS=600
SYNC_BURST_MIN_SOURCES=3

# Trusted domains for coordination detection exclusion
TRUSTED_DOMAINS=reuters.com,apnews.com,bloomberg.com,wsj.com,ft.com

# Optional API keys (leave empty to disable that source)

# Finnhub (optional — enables live stock prices)
# FINNHUB_API_KEY=
FINNHUB_CACHE_TTL_SECONDS=60
FINNHUB_REFRESH_INTERVAL_SECONDS=300
IMPACT_SCORE_REFRESH_SECONDS=600

MARKETAUX_API_KEY=
NEWSDATA_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=narrative_engine/1.0

# API feature flags
ENABLE_MARKETAUX=true
ENABLE_NEWSDATA=true
ENABLE_REDDIT=true
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# API rate quotas
MARKETAUX_DAILY_LIMIT=100
NEWSDATA_DAILY_LIMIT=200
REDDIT_POSTS_PER_SUB=50

# Phase 2: Additional data providers (leave empty to disable)
# TWELVE_DATA_API_KEY=
# COINGECKO_API_KEY=
ENABLE_TWELVE_DATA=false
ENABLE_COINGECKO=false

# WebSocket relay settings
WEBSOCKET_SYMBOLS_LIMIT=50
PRICE_TICK_RETENTION_HOURS=48
WEBSOCKET_FLUSH_INTERVAL_SECONDS=5
WEBSOCKET_RECONNECT_MAX_DELAY_SECONDS=300
ANALYTICS_BG_REFRESH_SECONDS=14400
SENTIMENT_SOCIAL_REFRESH_SECONDS=900
SENTIMENT_COMPOSITE_REFRESH_SECONDS=3600

# SEC EDGAR filings (requires valid email for SEC User-Agent policy)
# Runtime EDGAR ingestion uses EDGAR_EMAIL. Build-time asset-library downloads use SEC_EDGAR_EMAIL.
# If either EDGAR path is enabled, replace placeholder emails with a valid contact email.
ENABLE_EDGAR=false
EDGAR_EMAIL=
EDGAR_COMPANY_NAME=NarrativeIntelligenceEngine
EDGAR_TICKERS=
SEC_EDGAR_EMAIL=research@example.com

# Phase 4: Catalyst anchoring
FRED_API_KEY=
CATALYST_LOOKFORWARD_DAYS=14
FRED_CACHE_TTL_HOURS=6

# Phase 5: Learned signal weights
SIGNAL_MODEL_PATH=./data/signal_model.pkl
SIGNAL_MODEL_RETRAIN_DAYS=7
SIGNAL_MIN_TRAINING_SAMPLES=30

# Discord webhook (draft queue for manual posting)
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_ENABLED=false

# SMTP / Email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_TO=
SMTP_PASSWORD=

# Generic webhook channel
NOTIFICATION_WEBHOOK_URL=

# Environment — "development" or "production"
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
DISABLE_BACKGROUND_TASKS=false

# Auth mode: "stub" (single-user, no real passwords) or "jwt" (multi-user)
AUTH_MODE=stub
JWT_SECRET_KEY=
# JWT_EXPIRY_HOURS: session length in hours. Default is 2. Increase if longer sessions are needed.
JWT_EXPIRY_HOURS=2
AUTH_REQUIRED_FOR_USER_STATE=true

# STUB_AUTH_TOKEN: dev-only bearer token for AUTH_MODE=stub. Not needed in jwt mode.
STUB_AUTH_TOKEN=stub-auth-token

# SSE and login protection limits
# SSE_MAX_GLOBAL=100
# SSE_MAX_PER_USER=5
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_SECONDS=900

# Pipeline tuning constants (safe to leave at defaults)
# CLUSTERING_COHERENCE_THRESHOLD=0.5
# PIPELINE_FAILED_JOB_MAX_RETRIES=3
# PIPELINE_EXPORT_COHESION_GATE=0.999
# PIPELINE_EXPORT_MAX_DOC_COUNT=5
# OUTPUT_EXCERPT_TRUNCATION=280
